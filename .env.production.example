# Drydock environment template: PRODUCTION.
#
#   cp .env.production.example .env    # load secrets from a secret manager
#
# Production mode (DRYDOCK_ENV=production) refuses to start unless:
#   - relays are explicit and none of the built-in public defaults;
#   - DRYDOCK_MONITORED_REPOS_AUTHOR and a signer are set;
#   - planner, coder32b, llm70b, coder14b and meta endpoints, models and API
#     keys are explicit;
#   - every configured endpoint (LLMs, Qdrant, embeddings, version registries)
#     uses https:// and is not localhost/loopback;
#   - Qdrant URL + API key and embedding URL + model + API key are set.
# Local model servers therefore need TLS and an API key: llama-server supports
# --ssl-cert-file/--ssl-key-file and --api-key-file natively, or put them
# behind a TLS reverse proxy (docs/deployment.md, "Production TLS").
# If you use a private CA, make drydock trust it (SSL_CERT_FILE, below).

DRYDOCK_ENV=production
DRYDOCK_MODE=listener
DRYDOCK_LOG_LEVEL=info

DRYDOCK_DATABASE_URL='file:/data/drydock.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(wal)'
DRYDOCK_REPO_CACHE_DIR=/data/repos
TIKTOKEN_CACHE_DIR=/data/tiktoken-cache
# PEM bundle including your private CA, if endpoints use one (Go reads this).
# SSL_CERT_FILE=/run/secrets/ca-bundle.pem

# --- Nostr -------------------------------------------------------------------
# Your own relays; damus/nos.lol/primal defaults are rejected in production.
DRYDOCK_RELAYS=wss://relay.example.invalid
# Or split read/write (both required if DRYDOCK_RELAYS is unset):
# DRYDOCK_READ_RELAYS=
# DRYDOCK_WRITE_RELAYS=
DRYDOCK_MONITORED_REPOS_AUTHOR=npub1replace-with-operator-pubkey
DRYDOCK_SIGNER_BUNKER_URL='bunker://replace-with-signer-pubkey?relay=wss://relay.example.invalid&secret=replace-with-secret'
# Alternative to a bunker (file mode 0600, mounted as a secret):
# DRYDOCK_SIGNER_NSEC_FILE=/run/secrets/drydock-nsec
# Pubkeys whose zap receipts are trusted (empty disables zap payments; warns).
DRYDOCK_TRUSTED_ZAPPERS=

# --- LLM endpoints (all https, not loopback) ---------------------------------
DRYDOCK_LLM_API_KEY=replace-with-secret-manager-value
DRYDOCK_PLANNER_BASE_URL=https://llm.example.invalid:8443/v1
DRYDOCK_PLANNER_MODEL=qwen3.8-27b
DRYDOCK_CODER32B_BASE_URL=https://llm.example.invalid:8443/v1
DRYDOCK_CODER32B_MODEL=qwen3.8-27b
DRYDOCK_LLM70B_BASE_URL=https://llm.example.invalid:8443/v1
DRYDOCK_LLM70B_MODEL=qwen3.8-27b
DRYDOCK_CODER14B_BASE_URL=https://llm.example.invalid:8443/v1
DRYDOCK_CODER14B_MODEL=qwen3.8-27b
DRYDOCK_META_BASE_URL=https://llm.example.invalid:8443/v1
DRYDOCK_META_MODEL=qwen3.8-27b
# Per-role keys override DRYDOCK_LLM_API_KEY when endpoints differ:
#   DRYDOCK_PLANNER_API_KEY, DRYDOCK_CODER32B_API_KEY, DRYDOCK_LLM70B_API_KEY,
#   DRYDOCK_CODER14B_API_KEY, DRYDOCK_META_API_KEY

DRYDOCK_AGENTIC_REVIEW_FALLBACK=true
DRYDOCK_LLM_TIMEOUT=300s
DRYDOCK_LLM_MAX_TOKENS=8192
DRYDOCK_PIPELINE_WORKERS=1

# --- Retrieval (required in production) --------------------------------------
# Bundled Qdrant over TLS via docker-compose.production.yml, or your own
# https:// Qdrant endpoint.
DRYDOCK_QDRANT_URL=https://qdrant:6333
DRYDOCK_QDRANT_API_KEY=replace-with-secret-manager-value
DRYDOCK_EMBED_BASE_URL=https://embed.example.invalid:8444/v1
DRYDOCK_EMBED_MODEL=nomic-embed-text-v1.5
DRYDOCK_EMBED_API_KEY=replace-with-secret-manager-value
DRYDOCK_EMBED_DIMENSION=768

# --- Management listener -----------------------------------------------------
DRYDOCK_DASHBOARD_BEARER_TOKEN=replace-with-a-long-random-secret

# --- Sidecars (keep values even when the profiles are off) --------------------
LSP_BRIDGE_AUTH_TOKEN=replace-with-a-long-random-secret
DEP_RUNNER_AUTH_TOKEN=replace-with-a-long-random-secret
DRYDOCK_DEPUPGRADE_ENABLED=false

DRYDOCK_EVAL_DATASET_PATH=/app/eval/heldout-sample.json
