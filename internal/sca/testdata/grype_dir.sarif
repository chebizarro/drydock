{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.74.0",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2024-1111-github.com/foo/bar",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": { "text": "CVE-2024-1111 high vulnerability for github.com/foo/bar package" },
              "fullDescription": { "text": "Version 1.2.0 is affected with an available fix in versions 1.2.4,1.3.0" },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-1111\nSeverity: high\nPackage: github.com/foo/bar\nVersion: 1.2.0\nFix Version: 1.2.4,1.3.0\nType: go-module\nLocation: go.mod\nData Namespace: github:language:go\nLink: CVE-2024-1111",
                "markdown": "**Vulnerability CVE-2024-1111**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | github.com/foo/bar  | 1.2.0  | 1.2.4,1.3.0  | go-module  | go.mod  | github:language:go  | CVE-2024-1111  |\n"
              },
              "properties": {
                "purls": ["pkg:golang/github.com/foo/bar@1.2.0"],
                "security-severity": "7.5"
              }
            },
            {
              "id": "CVE-2024-2222-github.com/baz/qux",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": { "text": "CVE-2024-2222 critical vulnerability for github.com/baz/qux package" },
              "fullDescription": { "text": "Version 0.9.0 is affected with an available fix in versions 0.9.1" },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability CVE-2024-2222\nSeverity: critical\nPackage: github.com/baz/qux\nVersion: 0.9.0\nFix Version: 0.9.1\nType: go-module\nLocation: go.mod\nData Namespace: github:language:go\nLink: CVE-2024-2222",
                "markdown": "**Vulnerability CVE-2024-2222**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | github.com/baz/qux  | 0.9.0  | 0.9.1  | go-module  | go.mod  | github:language:go  | CVE-2024-2222  |\n"
              },
              "properties": {
                "purls": ["pkg:golang/github.com/baz/qux@0.9.0"],
                "security-severity": "9.8"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-1111-github.com/foo/bar",
          "level": "error",
          "message": { "text": "A high vulnerability in go-module package: github.com/foo/bar, version 1.2.0 was found at: go.mod" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "go.mod" },
                "region": { "startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1 }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "aaaa:1" }
        },
        {
          "ruleId": "CVE-2024-2222-github.com/baz/qux",
          "level": "error",
          "message": { "text": "A critical vulnerability in go-module package: github.com/baz/qux, version 0.9.0 was found at: go.mod" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "go.mod" },
                "region": { "startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1 }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "bbbb:1" }
        }
      ]
    }
  ]
}
