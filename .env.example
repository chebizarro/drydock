# Drydock environment template: DEVELOPMENT / single host with local models.
#
#   cp .env.example .env      # then edit the values marked REQUIRED
#
# Production deployments start from .env.production.example instead (TLS and
# API keys on every endpoint). Every variable is documented in
# docs/configuration.md; the walkthrough is docs/deployment.md and model
# serving is docs/local-models.md.
#
# Keep comments on their own lines: this file is read by Docker Compose and
# by `set -a; . ./.env; set +a` for native runs.

# --- Runtime -----------------------------------------------------------------
# development: plain-HTTP/local endpoints allowed, missing optional services
# only warn. production: see .env.production.example.
DRYDOCK_ENV=development
# listener | eval | drift-guard (selects the binary in scripts/entrypoint.sh)
DRYDOCK_MODE=listener
DRYDOCK_LOG_LEVEL=info

# --- Persistence (container paths; native runs may use relative paths) -------
DRYDOCK_DATABASE_URL='file:/data/drydock.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(wal)'
DRYDOCK_REPO_CACHE_DIR=/data/repos
DRYDOCK_REPO_CACHE_MAX_COUNT=50
DRYDOCK_REPO_CACHE_MAX_SIZE_MB=10240
# Tokenizer cache for the agentic review path (downloads cl100k_base once).
TIKTOKEN_CACHE_DIR=/data/tiktoken-cache

# --- Nostr -------------------------------------------------------------------
# REQUIRED: relays to read patches from and publish reviews to (comma-separated).
DRYDOCK_RELAYS=wss://relay.example.invalid
# REQUIRED for reviews: hex or npub of the identity that publishes the
# kind-30001 "drydock:monitored-repositories:v1" list. Without it (development)
# reactive review is disabled. See docs/deployment.md, "Choose what to review".
DRYDOCK_MONITORED_REPOS_AUTHOR=
# Signer for published reviews. A NIP-46 bunker is preferred; otherwise point
# DRYDOCK_SIGNER_NSEC_FILE at a file containing the nsec (mode 0600). With no
# signer, development mode runs listen-only (nothing is published).
# Keep bunker URLs in single quotes: they contain '&', which breaks shell
# sourcing otherwise, e.g. DRYDOCK_SIGNER_BUNKER_URL='bunker://...?relay=...&secret=...'
# A signer file must be mounted into the container (docs/deployment.md, step 2).
DRYDOCK_SIGNER_BUNKER_URL=
DRYDOCK_SIGNER_NSEC_FILE=

# --- Local LLM endpoints -----------------------------------------------------
# One llama.cpp llama-server on the host serving qwen3.8-27b with thinking off
# (see docs/local-models.md). host.docker.internal reaches the host from the
# container; the server must listen on an address the container can reach
# (e.g. --host 0.0.0.0 behind a firewall, or the docker bridge IP), not only
# 127.0.0.1. For native runs use http://127.0.0.1:8080/v1.
# The model names must match the server's --alias.
DRYDOCK_LLM_API_KEY=
DRYDOCK_PLANNER_BASE_URL=http://host.docker.internal:8080/v1
DRYDOCK_PLANNER_MODEL=qwen3.8-27b
DRYDOCK_CODER32B_BASE_URL=http://host.docker.internal:8080/v1
DRYDOCK_CODER32B_MODEL=qwen3.8-27b
DRYDOCK_LLM70B_BASE_URL=http://host.docker.internal:8080/v1
DRYDOCK_LLM70B_MODEL=qwen3.8-27b
DRYDOCK_CODER14B_BASE_URL=http://host.docker.internal:8080/v1
DRYDOCK_CODER14B_MODEL=qwen3.8-27b
# Meta-review (asynchronous quality control of a sample of reviews). Point it
# at the same local server, or at a stronger model if you accept sending
# patches to it.
DRYDOCK_META_BASE_URL=http://host.docker.internal:8080/v1
DRYDOCK_META_MODEL=qwen3.8-27b

# Single-shot review path. Recommended on modest GPUs until the agentic path
# has been measured on your hardware (it sends 100k-1M prompt tokens per
# review). Set false to use the agentic default.
DRYDOCK_AGENTIC_REVIEW_FALLBACK=true
# Per-call LLM timeout (Go duration). 180s is the default; slow GPUs such as
# Tesla P40 may need more. Timed-out calls are not retried.
DRYDOCK_LLM_TIMEOUT=300s
# Completion-token cap (0 = none). 8192 suits thinking-off models.
DRYDOCK_LLM_MAX_TOKENS=0
# Concurrent reviews. Keep at 1 per llama-server slot unless you serve more.
DRYDOCK_PIPELINE_WORKERS=1
# Review context budget in tokens (default 64000, about 57,600 effective after
# headroom). Set it to the model server's per-slot context minus ~8k, e.g.
# 24000 for a 32k server. Repositories can only lower it.
DRYDOCK_CONTEXT_TOKEN_BUDGET=64000

# --- Retrieval (optional in development) -------------------------------------
# Qdrant runs in the compose stack. Embeddings: a second llama-server started
# with --embeddings (docs/local-models.md). Leave DRYDOCK_EMBED_BASE_URL empty
# to disable retrieval features.
DRYDOCK_QDRANT_URL=http://qdrant:6333
DRYDOCK_QDRANT_API_KEY=
DRYDOCK_EMBED_BASE_URL=
DRYDOCK_EMBED_MODEL=nomic-embed-text-v1.5
DRYDOCK_EMBED_API_KEY=
DRYDOCK_EMBED_DIMENSION=768

# --- Management listener -----------------------------------------------------
# Inside the container compose binds :8081 and publishes it on host loopback.
# The dashboard is unauthenticated unless this token is set.
DRYDOCK_DASHBOARD_BEARER_TOKEN=

# --- Optional sidecars -------------------------------------------------------
# Compose interpolates these even when their profiles are off, so keep a value
# here. Replace with long random secrets before enabling the profiles:
#   docker compose --profile lsp up -d          (LSP bridge)
#   docker compose --profile depupgrade up -d   (dependency-upgrade runner)
LSP_BRIDGE_AUTH_TOKEN=replace-with-a-long-random-secret
DEP_RUNNER_AUTH_TOKEN=replace-with-a-long-random-secret
# Dependency upgrades also need DRYDOCK_DEP_RUNNER_URL and a signer (the
# monitored-repository registry needs the service identity); per-repo opt-in
# lives in .drydock.yaml.
DRYDOCK_DEPUPGRADE_ENABLED=false
DRYDOCK_DEPUPGRADE_INTERVAL=24h
DRYDOCK_DEPUPGRADE_WORKERS=1

# --- Evaluation --------------------------------------------------------------
DRYDOCK_EVAL_DATASET_PATH=/app/eval/heldout-sample.json
